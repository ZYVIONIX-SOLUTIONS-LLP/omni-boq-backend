generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Manufacturer {
  id             String         @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime       @default(now())
  isActive       Boolean        @default(true)
  nameNormalized String
  tenantId       String?
  updatedAt      DateTime       @updatedAt
  products       ProductModel[]

  @@unique([tenantId, nameNormalized])
  @@index([tenantId])
  @@map("manufacturers")
}

model CatalogCategory {
  id             String                @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime              @default(now())
  defaultGstRate Decimal?              @db.Decimal(5, 2)
  hsnCode        String?
  isActive       Boolean               @default(true)
  nameNormalized String
  tenantId       String?
  updatedAt      DateTime              @updatedAt
  requirements   ActivityRequirement[]
  attributeDefs  AttributeDef[]
  products       ProductModel[]
  subCategories  SubCategory[]

  @@unique([tenantId, nameNormalized])
  @@index([tenantId])
  @@map("catalog_categories")
}

model SubCategory {
  id             String                @id @default(cuid())
  name           String
  description    String?
  categoryId     String
  createdAt      DateTime              @default(now())
  isActive       Boolean               @default(true)
  nameNormalized String
  updatedAt      DateTime              @updatedAt
  requirements   ActivityRequirement[]
  products       ProductModel[]
  category       CatalogCategory       @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, nameNormalized])
  @@map("sub_categories")
}

model AttributeDef {
  id             String          @id @default(cuid())
  name           String
  description    String?
  type           AttributeType
  unit           String?
  options        String[]        @default([])
  required       Boolean         @default(false)
  categoryId     String
  createdAt      DateTime        @default(now())
  isActive       Boolean         @default(true)
  nameNormalized String
  sortOrder      Int             @default(0)
  updatedAt      DateTime        @updatedAt
  category       CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, nameNormalized])
  @@map("attribute_defs")
}

model ProductModel {
  id               String           @id @default(cuid())
  name             String?
  attributes       Json             @default("{}")
  images           Json             @default("{\"gallery\": []}")
  status           ProductStatus    @default(ACTIVE)
  categoryId       String?
  categoryName     String?
  color            String?
  createdAt        DateTime         @default(now())
  discountPercent  Decimal?         @db.Decimal(5, 2)
  gstRate          Decimal?         @db.Decimal(5, 2)
  hsnCode          String?
  manufacturerId   String?
  manufacturerName String?
  modelCode        String?
  mrp              Decimal?         @db.Decimal(12, 2)
  series           String?
  subCategoryId    String?
  subCategoryName  String?
  tenantId         String?
  unit             String?
  updatedAt        DateTime         @updatedAt
  voltageClass     VoltageClass?
  category         CatalogCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  manufacturer     Manufacturer?    @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  subCategory      SubCategory?     @relation(fields: [subCategoryId], references: [id])

  @@index([manufacturerId, series, modelCode])
  @@index([categoryId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("products")
}

model Activity {
  id           String                @id @default(cuid())
  code         String                @unique
  name         String
  segment      ProjectSegment?
  unit         UnitOfMeasure
  description  String?
  category     String?
  createdAt    DateTime              @default(now())
  isActive     Boolean               @default(true)
  labourCost   Decimal?              @db.Decimal(12, 2)
  sheetData    Json?
  tenantId     String?
  updatedAt    DateTime              @updatedAt
  wiringType   String
  isDeleted    Boolean               @default(false)
  charges      ActivityCharge[]
  requirements ActivityRequirement[]

  @@index([wiringType])
  @@index([segment])
  @@index([tenantId])
  @@map("activities")
}

model ActivityRequirement {
  id                 String          @id @default(cuid())
  description        String
  unit               UnitOfMeasure
  quantity           Decimal         @db.Decimal(12, 2)
  activityId         String
  categoryId         String
  requiredAttributes Json            @default("{}")
  sortOrder          Int             @default(0)
  subCategoryId      String?
  activity           Activity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  category           CatalogCategory @relation(fields: [categoryId], references: [id])
  subCategory        SubCategory?    @relation(fields: [subCategoryId], references: [id])

  @@index([activityId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@map("activity_requirements")
}

/// * A standalone cost line on an Activity that isn't tied to any catalog category or
///  *  product — labour, delivery, testing, or any other flat charge. Added via its own
///  *  "Add Charge" action, separate from material Requirements.
model ActivityCharge {
  id          String   @id @default(cuid())
  activityId  String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("activity_charges")
}

model Quotation {
  id                     String             @id @default(cuid())
  code                   String             @unique
  status                 QuotationStatus    @default(DRAFT)
  activityCustomizations Json?
  activityRows           Json?
  brandPreferences       Json?
  createdAt              DateTime           @default(now())
  grandTotal             Decimal            @default(0) @db.Decimal(14, 2)
  sheetData              Json?
  subTotal               Decimal            @default(0) @db.Decimal(14, 2)
  taxTotal               Decimal            @default(0) @db.Decimal(14, 2)
  tenantId               String?
  termsAndConditions     String?
  updatedAt              DateTime           @updatedAt
  validTill              DateTime?
  customer               QuotationCustomer?
  items                  QuotationItem[]
  project                QuotationProject?

  @@index([tenantId])
  @@map("quotations")
}

model QuotationCustomer {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  address     String?
  quotationId String    @unique
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_customers")
}

model QuotationProject {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  endDate     DateTime?
  quotationId String    @unique
  startDate   DateTime?
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_projects")
}

model QuotationItem {
  id           String    @id @default(cuid())
  description  String
  unit         String
  quantity     Decimal   @db.Decimal(12, 2)
  rate         Decimal   @db.Decimal(12, 2)
  amount       Decimal   @db.Decimal(14, 2)
  discountPct  Decimal   @default(0) @db.Decimal(5, 2)
  profitPct    Decimal   @default(0) @db.Decimal(5, 2)
  quotationId  String
  sortOrder    Int       @default(0)
  taxRate      Decimal   @default(0) @db.Decimal(5, 2)
  snapshotData Json?
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String?
  phone         String?
  gst           String?
  companyAddress String?
  role          UserRole?
    priorityLevel Int?
  adminId       String?
  companyName   String?
  companyCustomFields Json?
  createdAt     DateTime       @default(now())
  firstName     String
  lastName      String
  passwordHash  String         @map("password")
  status        UserStatus     @default(APPROVED)
  refreshTokens RefreshToken[]
  notifications Notification[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model TenantMaterialConfig {
  id             String   @id @default(cuid())
  tenantId       String
  categoryId     String
  subCategoryId  String?
  specHash       String
  productModelId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, categoryId, subCategoryId, specHash], name: "unique_tenant_config")
  @@map("tenant_material_configs")
}

// ── Dynamic Activity Types and Categories ──────────────────────────────────

model ActivityType {
  id             String             @id @default(cuid())
  tenantId       String?
  name           String
  nameNormalized String

  categories     ActivityCategory[]

  @@unique([tenantId, nameNormalized])
  @@map("activity_types")
}

model ActivityCategory {
  id             String       @id @default(cuid())
  tenantId       String?
  typeId         String
  name           String
  nameNormalized String

  type       ActivityType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, typeId, nameNormalized])
  @@map("activity_categories")
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}



enum ProjectSegment {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
}

enum UnitOfMeasure {
  NOS
  MTR
  SQFT
  SET
  ROLL
  KG
  LTR
  LOT
  POINT
  CIRCUIT
}

enum QuotationStatus {
  DRAFT
  FINAL
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum UserRole {
  STAFF
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  PENDING
  APPROVED
}

enum VoltageClass {
  LV
  MV
  HV
  EHV
}
model CompanyDocument {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  fileUrl   String?
  fileType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   // The admin/user receiving it
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("notifications")
}
