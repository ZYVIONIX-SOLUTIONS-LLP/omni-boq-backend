generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Manufacturer {
  id             String         @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime       @default(now())
  isActive       Boolean        @default(true)
  nameNormalized String         @unique
  updatedAt      DateTime       @updatedAt
  products       ProductModel[]

  @@map("manufacturers")
}

model CatalogCategory {
  id             String         @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime       @default(now())
  defaultGstRate Decimal?       @db.Decimal(5, 2)
  hsnCode        String?
  isActive       Boolean        @default(true)
  nameNormalized String         @unique
  updatedAt      DateTime       @updatedAt
  attributeDefs  AttributeDef[]
  products       ProductModel[]
  subCategories  SubCategory[]

  @@map("catalog_categories")
}

model SubCategory {
  id             String          @id @default(cuid())
  name           String
  description    String?
  categoryId     String
  createdAt      DateTime        @default(now())
  isActive       Boolean         @default(true)
  nameNormalized String
  updatedAt      DateTime        @updatedAt
  products       ProductModel[]
  category       CatalogCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, nameNormalized])
  @@map("sub_categories")
}

model AttributeDef {
  id             String          @id @default(cuid())
  name           String
  description    String?
  type           AttributeType
  unit           String?
  options        String[]        @default([])
  required       Boolean         @default(false)
  categoryId     String
  createdAt      DateTime        @default(now())
  isActive       Boolean         @default(true)
  nameNormalized String
  sortOrder      Int             @default(0)
  updatedAt      DateTime        @updatedAt
  category       CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, nameNormalized])
  @@map("attribute_defs")
}

model ProductModel {
  id               String           @id @default(cuid())
  name             String?
  attributes       Json             @default("{}")
  images           Json             @default("{\"gallery\": []}")
  status           ProductStatus    @default(ACTIVE)
  categoryId       String?
  categoryName     String?
  color            String?
  createdAt        DateTime         @default(now())
  discountPercent  Decimal?         @db.Decimal(5, 2)
  gstRate          Decimal?         @db.Decimal(5, 2)
  hsnCode          String?
  manufacturerId   String?
  manufacturerName String?
  modelCode        String?
  mrp              Decimal?         @db.Decimal(12, 2)
  series           String?
  subCategoryId    String?
  subCategoryName  String?
  tenantId         String?
  unit             String?
  updatedAt        DateTime         @updatedAt
  voltageClass     VoltageClass?
  category         CatalogCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  manufacturer     Manufacturer?    @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  subCategory      SubCategory?     @relation(fields: [subCategoryId], references: [id])

  @@index([manufacturerId, series, modelCode])
  @@index([categoryId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("products")
}

model Activity {
  id                 String                @id @default(cuid())
  code               String                @unique
  name               String
  unit               UnitOfMeasure         @default(POINT)
  description        String?
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  wiringType         WiringType            @default(POINT_WIRING)
  segment            ProjectSegment?
  activity_labours   activity_labours[]
  activity_materials activity_materials[]
  requirements       ActivityRequirement[]
  boq_items          boq_items[]
  circuit_wirings    circuit_wirings[]
  point_wirings      point_wirings[]

  @@index([wiringType])
  @@index([segment])
  @@map("activities")
}

model ActivityRequirement {
  id          String        @id @default(cuid())
  activityId  String
  description String
  unit        UnitOfMeasure @default(NOS)
  quantity    Decimal       @db.Decimal(12, 3)
  sortOrder   Int           @default(0)
  categoryId  String
  activity    Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  category    categories    @relation(fields: [categoryId], references: [id])

  @@index([activityId])
  @@index([categoryId])
  @@map("activity_requirements")
}

/// * A standalone cost line on an Activity that isn't tied to any catalog category or
/// *  product — labour, delivery, testing, or any other flat charge. Added via its own
/// *  "Add Charge" action, separate from material Requirements.
model ActivityCharge {
  id          String  @id @default(cuid())
  activityId  String
  description String
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  @@index([activityId])
  @@map("activity_charges")
}

model Quotation {
  id                 String          @id @default(cuid())
  code               String          @unique
  projectId          String?
  customerId         String
  boqId              String?
  status             QuotationStatus @default(DRAFT)
  validTill          DateTime?
  subTotal           Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal           Decimal         @default(0) @db.Decimal(14, 2)
  grandTotal         Decimal         @default(0) @db.Decimal(14, 2)
  termsAndConditions String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  items              QuotationItem[]
  boqs               boqs?           @relation(fields: [boqId], references: [id])
  customers          customers       @relation(fields: [customerId], references: [id])
  projects           projects?       @relation(fields: [projectId], references: [id])

  @@map("quotations")
}

model QuotationCustomer {
  id          String  @id @default(cuid())
  name        String
  phone       String?
  address     String?
  quotationId String  @unique

  @@map("quotation_customers")
}

model QuotationProject {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  endDate     DateTime?
  quotationId String    @unique
  startDate   DateTime?

  @@map("quotation_projects")
}

model QuotationItem {
  id          String        @id @default(cuid())
  quotationId String
  description String
  unit        UnitOfMeasure @default(NOS)
  quantity    Decimal       @db.Decimal(12, 3)
  rate        Decimal       @db.Decimal(12, 2)
  taxRate     Decimal       @default(0) @db.Decimal(5, 2)
  amount      Decimal       @db.Decimal(14, 2)
  sortOrder   Int           @default(0)
  discountPct Decimal       @default(0) @db.Decimal(5, 2)
  profitPct   Decimal       @default(0) @db.Decimal(5, 2)
  quotation   Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model User {
  id            String          @id @default(cuid())
  email         String?         @unique
  phone         String?         @unique
  passwordHash  String          @map("password")
  firstName     String
  lastName      String
  isActive      Boolean         @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  deletedAt     DateTime?
  username      String          @unique
  notifications notifications[]
  refreshTokens RefreshToken[]
  upload_files  upload_files[]
  user_roles    user_roles[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model TenantMaterialConfig {
  id             String   @id @default(cuid())
  tenantId       String
  categoryId     String
  subCategoryId  String?
  specHash       String
  productModelId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, categoryId, subCategoryId, specHash], name: "unique_tenant_config")
  @@map("tenant_material_configs")
}

model ActivityType {
  id             String             @id @default(cuid())
  tenantId       String?
  name           String
  nameNormalized String
  categories     ActivityCategory[]

  @@unique([tenantId, nameNormalized])
  @@map("activity_types")
}

model ActivityCategory {
  id             String       @id @default(cuid())
  tenantId       String?
  typeId         String
  name           String
  nameNormalized String
  type           ActivityType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, typeId, nameNormalized])
  @@map("activity_categories")
}

model activity_labours {
  id         String   @id
  activityId String
  labourId   String
  quantity   Decimal  @db.Decimal(12, 3)
  activities Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  labours    labours  @relation(fields: [labourId], references: [id])

  @@unique([activityId, labourId])
}

model activity_materials {
  id         String    @id
  activityId String
  materialId String
  quantity   Decimal   @db.Decimal(12, 3)
  activities Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  materials  materials @relation(fields: [materialId], references: [id])

  @@unique([activityId, materialId])
}

model boq_items {
  id          String        @id
  boqId       String
  activityId  String?
  description String
  unit        UnitOfMeasure @default(NOS)
  quantity    Decimal       @db.Decimal(12, 3)
  rate        Decimal       @db.Decimal(12, 2)
  amount      Decimal       @db.Decimal(14, 2)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  activities  Activity?     @relation(fields: [activityId], references: [id])
  boqs        boqs          @relation(fields: [boqId], references: [id], onDelete: Cascade)
}

model boqs {
  id         String      @id
  code       String      @unique
  projectId  String
  version    Int         @default(1)
  status     BoqStatus   @default(DRAFT)
  remarks    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime
  deletedAt  DateTime?
  boq_items  boq_items[]
  projects   projects    @relation(fields: [projectId], references: [id])
  quotations Quotation[]
}

model brands {
  id        String      @id
  name      String      @unique
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime
  materials materials[]
}

model categories {
  id           String                @id
  name         String                @unique
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime
  requirements ActivityRequirement[]
  materials    materials[]
}

model circuit_wirings {
  id          String    @id
  code        String    @unique
  name        String
  activityId  String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  activities  Activity? @relation(fields: [activityId], references: [id])
}

model customers {
  id         String      @id
  name       String
  email      String?
  phone      String?
  gstNumber  String?
  address    String?
  city       String?
  state      String?
  pincode    String?
  notes      String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime
  deletedAt  DateTime?
  projects   projects[]
  quotations Quotation[]
}

model labours {
  id               String             @id
  code             String             @unique
  name             String
  skillLevel       String?
  unit             UnitOfMeasure      @default(NOS)
  unitPrice        Decimal            @default(0) @db.Decimal(12, 2)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  deletedAt        DateTime?
  activity_labours activity_labours[]
}

model materials {
  id                    String               @id
  code                  String               @unique
  name                  String
  unit                  UnitOfMeasure        @default(NOS)
  unitPrice             Decimal              @default(0) @db.Decimal(12, 2)
  hsnCode               String?
  gstRate               Decimal?             @db.Decimal(5, 2)
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime
  deletedAt             DateTime?
  series                String?
  insulationType        String?
  sizeSqmm              Decimal?             @db.Decimal(10, 3)
  coreCount             Int?
  conductorMaterial     String?
  conductorConstruction String?
  currentRatingAmps     Decimal?             @db.Decimal(10, 2)
  voltageGrade          String?
  standard              String?
  color                 String?
  categoryId            String
  brandId               String?
  activity_materials    activity_materials[]
  brands                brands?              @relation(fields: [brandId], references: [id])
  categories            categories           @relation(fields: [categoryId], references: [id])

  @@index([brandId])
  @@index([categoryId])
}

model notifications {
  id        String           @id
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())
  users     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model permissions {
  id               String             @id
  code             String             @unique
  module           String
  action           String
  description      String?
  createdAt        DateTime           @default(now())
  role_permissions role_permissions[]
}

model point_wirings {
  id          String    @id
  code        String    @unique
  name        String
  activityId  String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  activities  Activity? @relation(fields: [activityId], references: [id])
}

model projects {
  id          String        @id
  code        String        @unique
  name        String
  customerId  String
  siteAddress String?
  status      ProjectStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  boqs        boqs[]
  customers   customers     @relation(fields: [customerId], references: [id])
  quotations  Quotation[]
}

model role_permissions {
  roleId       String
  permissionId String
  permissions  permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  roles        roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model roles {
  id               String             @id
  name             String             @unique
  description      String?
  isSystem         Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model settings {
  id        String   @id
  key       String   @unique
  value     Json
  group     String   @default("general")
  updatedAt DateTime
}

model upload_files {
  id           String       @id
  originalName String
  storedName   String
  mimeType     String
  size         Int
  path         String
  module       String?
  entityId     String?
  status       UploadStatus @default(READY)
  uploadedById String?
  createdAt    DateTime     @default(now())
  users        User?        @relation(fields: [uploadedById], references: [id])

  @@index([module, entityId])
}

model user_roles {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  roles      roles    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  users      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ProjectSegment {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
}

enum UnitOfMeasure {
  NOS
  MTR
  SQFT
  SET
  ROLL
  KG
  LTR
  LOT
  POINT
  CIRCUIT
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum UserRole {
  STAFF
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  PENDING
  APPROVED
}

enum VoltageClass {
  LV
  MV
  HV
  EHV
}

enum BoqStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REVISED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum UploadStatus {
  PENDING
  READY
  FAILED
}

enum WiringType {
  POINT_WIRING
  CIRCUIT_WIRING
}
