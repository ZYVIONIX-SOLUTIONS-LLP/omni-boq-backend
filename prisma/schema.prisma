generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Shared enums ─────────────────────────────────────────────────────────

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum WiringType {
  POINT_WIRING
  CIRCUIT_WIRING
}

enum ProjectSegment {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
}

enum UnitOfMeasure {
  NOS
  MTR
  SQFT
  SET
  ROLL
  KG
  LTR
  LOT
  POINT
  CIRCUIT
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum UserRole {
  STAFF
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  PENDING
  APPROVED
}

enum VoltageClass {
  LV
  MV
  HV
  EHV
}

// ── Catalog hierarchy ────────────────────────────────────────────────────

model Manufacturer {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String  
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products  ProductModel[]

  @@unique([nameNormalized])
  @@map("manufacturers")
}

model CatalogCategory {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String  
  description    String?
  hsnCode        String? 
  defaultGstRate Decimal? @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subCategories SubCategory[]
  attributeDefs AttributeDef[]
  products      ProductModel[]
  requirements  ActivityRequirement[]

  @@unique([nameNormalized])
  @@map("catalog_categories")
}

model SubCategory {
  id             String   @id @default(cuid())
  categoryId     String  
  name           String
  nameNormalized String  
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products ProductModel[]
  requirements ActivityRequirement[]

  @@unique([categoryId, nameNormalized])
  @@map("sub_categories")
}

model AttributeDef {
  id             String        @id @default(cuid())
  categoryId     String       
  name           String
  nameNormalized String       
  description    String?
  type           AttributeType
  unit           String?
  options        String[]      @default([])
  required       Boolean       @default(false)
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, nameNormalized])
  @@map("attribute_defs")
}

// ── Products (Flat Model) ──────────────────────────────────────────────────

model ProductModel {
  id               String        @id @default(cuid())
  tenantId         String?      
  manufacturerId   String?      
  manufacturerName String?      
  series           String?      
  voltageClass     VoltageClass?
  categoryId       String?      
  categoryName     String?      
  subCategoryId    String?      
  subCategoryName  String?      
  name             String?
  color            String?
  modelCode        String?
  attributes       Json          @default("{}")
  unit             String?      
  hsnCode          String?      
  gstRate          Decimal?      @db.Decimal(5, 2)
  mrp              Decimal?      @db.Decimal(12, 2)
  discountPercent  Decimal?      @db.Decimal(5, 2)
  images           Json          @default("{\"gallery\":[]}")
  status           ProductStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  manufacturer Manufacturer?    @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  category     CatalogCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory  SubCategory?     @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)

  @@index([manufacturerId, series, modelCode])
  @@index([categoryId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("products")
}

// ── Activities ────────────────────────────────────────────────────────────

model Activity {
  id           String          @id @default(cuid())
  tenantId     String?        
  code         String          @unique
  name         String
  wiringType   WiringType     
  category     String?
  segment      ProjectSegment?
  unit         UnitOfMeasure
  description  String?
  isActive     Boolean         @default(true)
  sheetData    Json?          
  labourCost   Decimal?        @db.Decimal(12, 2)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  requirements ActivityRequirement[]
  charges      ActivityCharge[]

  @@index([wiringType])
  @@index([segment])
  @@index([tenantId])
  @@map("activities")
}

model ActivityRequirement {
  id                 String        @id @default(cuid())
  activityId         String
  categoryId         String
  subCategoryId      String?
  description        String
  unit               UnitOfMeasure
  quantity           Decimal       @db.Decimal(12, 2)
  requiredAttributes Json          @default("{}")
  sortOrder          Int           @default(0)

  activity    Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  category    CatalogCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory SubCategory?     @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)

  @@index([activityId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@map("activity_requirements")
}

/** A standalone cost line on an Activity that isn't tied to any catalog category or
 *  product — labour, delivery, testing, or any other flat charge. Added via its own
 *  "Add Charge" action, separate from material Requirements. */
model ActivityCharge {
  id          String   @id @default(cuid())
  activityId  String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("activity_charges")
}

// ── Quotations ────────────────────────────────────────────────────────────

model Quotation {
  id                     String          @id @default(cuid())
  tenantId               String?        
  code                   String          @unique
  status                 QuotationStatus @default(DRAFT)
  subTotal               Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal               Decimal         @default(0) @db.Decimal(14, 2)
  grandTotal             Decimal         @default(0) @db.Decimal(14, 2)
  validTill              DateTime?      
  termsAndConditions     String?        
  sheetData              Json?          
  activityRows           Json?          
  activityCustomizations Json?          
  brandPreferences       Json?          
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  customer QuotationCustomer?
  project  QuotationProject?
  items    QuotationItem[]

  @@index([tenantId])
  @@map("quotations")
}

model QuotationCustomer {
  id          String  @id @default(cuid())
  quotationId String  @unique
  name        String
  phone       String?
  address     String?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_customers")
}

model QuotationProject {
  id          String    @id @default(cuid())
  quotationId String    @unique
  code        String    @unique
  name        String
  startDate   DateTime?
  endDate     DateTime?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_projects")
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String 
  description String
  unit        String
  quantity    Decimal @db.Decimal(12, 2)
  rate        Decimal @db.Decimal(12, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  profitPct   Decimal @default(0) @db.Decimal(5, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  amount      Decimal @db.Decimal(14, 2)
  sortOrder   Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// ── Auth & users ──────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String     @map("password")
  firstName    String
  lastName     String
  role         UserRole?
  status       UserStatus @default(APPROVED)
  companyName  String?
  adminId      String?
  createdAt    DateTime   @default(now())

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
