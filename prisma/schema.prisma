generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Shared enums ─────────────────────────────────────────────────────────

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum WiringType {
  POINT_WIRING
  CIRCUIT_WIRING
}

enum ProjectSegment {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
}

enum UnitOfMeasure {
  NOS
  MTR
  SQFT
  SET
  ROLL
  KG
  LTR
  LOT
  POINT
  CIRCUIT
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum UserRole {
  STAFF
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  PENDING
  APPROVED
}

// ── Catalog hierarchy ────────────────────────────────────────────────────

model Manufacturer {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String  
  description    String?
  code           String?
  country        String?
  website        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  divisions Division[]
  series    ProductSeries[]
  products  ProductModel[]

  @@unique([nameNormalized])
  @@map("manufacturers")
}

model Division {
  id             String   @id @default(cuid())
  manufacturerId String  
  name           String
  nameNormalized String  
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer Manufacturer    @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  series       ProductSeries[]
  products     ProductModel[]

  @@unique([manufacturerId, nameNormalized])
  @@map("divisions")
}

model ProductSeries {
  id             String   @id @default(cuid())
  manufacturerId String  
  divisionId     String? 
  name           String
  nameNormalized String  
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer Manufacturer   @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  division     Division?      @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  products     ProductModel[]

  @@unique([manufacturerId, nameNormalized])
  @@map("product_series")
}

model CatalogCategory {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String  
  description    String?
  hsnCode        String? 
  defaultGstRate Decimal? @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subCategories SubCategory[]
  attributeDefs AttributeDef[]
  products      ProductModel[]
  requirements  ActivityRequirement[]

  @@unique([nameNormalized])
  @@map("catalog_categories")
}

model SubCategory {
  id             String   @id @default(cuid())
  categoryId     String  
  name           String
  nameNormalized String  
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products ProductModel[]

  @@unique([categoryId, nameNormalized])
  @@map("sub_categories")
}

model AttributeDef {
  id             String        @id @default(cuid())
  categoryId     String       
  name           String
  nameNormalized String       
  description    String?
  type           AttributeType
  unit           String?
  options        String[]      @default([])
  required       Boolean       @default(false)
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([categoryId, nameNormalized])
  @@map("attribute_defs")
}

model UnitDef {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String  
  description    String?
  symbol         String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products ProductModel[]

  @@unique([nameNormalized])
  @@map("unit_defs")
}

model TaxRate {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String  
  description    String?
  ratePercent    Decimal  @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([nameNormalized])
  @@map("tax_rates")
}

model HsnCode {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String  
  description    String?
  gstRate        Decimal? @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([nameNormalized])
  @@map("hsn_codes")
}

// ── Products & variants ──────────────────────────────────────────────────

model ProductModel {
  id               String        @id @default(cuid())
  tenantId         String?      
  name             String
  nameNormalized   String       
  description      String?
  manufacturerId   String?      
  manufacturerName String?      
  divisionId       String?      
  seriesId         String?      
  seriesName       String?      
  categoryId       String?      
  categoryName     String?      
  subCategoryId    String?      
  subCategoryName  String?      
  attributes       Json          @default("{}")
  unitId           String?      
  unitName         String?      
  hsnCode          String?      
  gstRate          Decimal?      @db.Decimal(5, 2)
  images           Json          @default("{\"gallery\":[]}")
  status           ProductStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  manufacturer Manufacturer?    @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  division     Division?        @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  series       ProductSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  category     CatalogCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory  SubCategory?     @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  unit         UnitDef?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  variants     Variant[]

  @@index([manufacturerId, seriesId, nameNormalized])
  @@index([categoryId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("products")
}

model Variant {
  id               String        @id @default(cuid())
  productId        String       
  name             String
  modelCode        String?      
  manufacturerSku  String?      
  internalSku      String?      
  barcode          String?
  ean              String?
  attributes       Json          @default("{}")
  priceMrp         Decimal?      @db.Decimal(12, 2)
  priceDealer      Decimal?      @db.Decimal(12, 2)
  priceDistributor Decimal?      @db.Decimal(12, 2)
  priceContractor  Decimal?      @db.Decimal(12, 2)
  pricePurchase    Decimal?      @db.Decimal(12, 2)
  priceOffer       Decimal?      @db.Decimal(12, 2)
  gstRate          Decimal?      @db.Decimal(5, 2)
  discountPercent  Decimal?      @db.Decimal(5, 2)
  stockQty         Int?         
  status           ProductStatus @default(ACTIVE)
  image            Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  product            ProductModel                @relation(fields: [productId], references: [id], onDelete: Cascade)
  requirementOptions ActivityRequirementOption[]

  @@index([productId])
  @@index([modelCode])
  @@index([manufacturerSku])
  @@index([internalSku])
  @@index([barcode])
  @@map("variants")
}

// ── Activities ────────────────────────────────────────────────────────────

model Activity {
  id           String          @id @default(cuid())
  tenantId     String?        
  code         String          @unique
  name         String
  wiringType   WiringType     
  category     String?
  segment      ProjectSegment?
  unit         UnitOfMeasure
  description  String?
  isActive     Boolean         @default(true)
  sheetData    Json?          
  materialCost Decimal?        @db.Decimal(12, 2)
  labourCost   Decimal?        @db.Decimal(12, 2)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  requirements ActivityRequirement[]

  @@index([wiringType])
  @@index([segment])
  @@index([tenantId])
  @@map("activities")
}

model ActivityRequirement {
  id          String        @id @default(cuid())
  activityId  String       
  categoryId  String       
  description String
  unit        UnitOfMeasure
  quantity    Decimal       @db.Decimal(12, 2)
  sortOrder   Int           @default(0)

  activity Activity                    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  category CatalogCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  options  ActivityRequirementOption[]

  @@index([activityId])
  @@index([categoryId])
  @@map("activity_requirements")
}

// One row per alternate "make" (a specific catalog variant) a requirement can be fulfilled
// with. Exactly one option per requirement is flagged isDefault — that's the make whose name
// and price populate the requirement's row in the Activity's own spreadsheet; Quotations pick
// among these same options via their own per-row override instead of the full catalog search.
model ActivityRequirementOption {
  id            String  @id @default(cuid())
  requirementId String 
  variantId     String 
  isDefault     Boolean @default(false)
  sortOrder     Int     @default(0)

  requirement ActivityRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  variant     Variant             @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([requirementId, variantId])
  @@index([requirementId])
  @@index([variantId])
  @@map("activity_requirement_options")
}

// ── Quotations ────────────────────────────────────────────────────────────

model Quotation {
  id                     String          @id @default(cuid())
  tenantId               String?        
  code                   String          @unique
  status                 QuotationStatus @default(DRAFT)
  subTotal               Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal               Decimal         @default(0) @db.Decimal(14, 2)
  grandTotal             Decimal         @default(0) @db.Decimal(14, 2)
  validTill              DateTime?      
  termsAndConditions     String?        
  sheetData              Json?          
  activityRows           Json?          
  activityCustomizations Json?          
  brandPreferences       Json?          
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  customer QuotationCustomer?
  project  QuotationProject?
  items    QuotationItem[]

  @@index([tenantId])
  @@map("quotations")
}

model QuotationCustomer {
  id          String  @id @default(cuid())
  quotationId String  @unique
  name        String
  phone       String?
  address     String?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_customers")
}

model QuotationProject {
  id          String    @id @default(cuid())
  quotationId String    @unique
  code        String    @unique
  name        String
  startDate   DateTime?
  endDate     DateTime?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_projects")
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String 
  description String
  unit        String
  quantity    Decimal @db.Decimal(12, 2)
  rate        Decimal @db.Decimal(12, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  profitPct   Decimal @default(0) @db.Decimal(5, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  amount      Decimal @db.Decimal(14, 2)
  sortOrder   Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// ── Auth & users ──────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String     @map("password")
  firstName    String
  lastName     String
  role         UserRole?
  status       UserStatus @default(APPROVED)
  companyName  String?
  adminId      String?
  createdAt    DateTime   @default(now())

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
