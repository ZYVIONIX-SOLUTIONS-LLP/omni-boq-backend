generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Shared enums ─────────────────────────────────────────────────────────

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum WiringType {
  POINT_WIRING
  CIRCUIT_WIRING
}

enum ProjectSegment {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
}

enum UnitOfMeasure {
  NOS
  MTR
  SQFT
  SET
  ROLL
  KG
  LTR
  LOT
  POINT
  CIRCUIT
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum UserRole {
  STAFF
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  PENDING
  APPROVED
}

// ── Catalog hierarchy ────────────────────────────────────────────────────

model Manufacturer {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String   @map("name_normalized")
  description    String?
  code           String?
  country        String?
  website        String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  divisions Division[]
  series    ProductSeries[]
  products  ProductModel[]

  @@unique([nameNormalized])
  @@map("manufacturers")
}

model Division {
  id             String   @id @default(cuid())
  manufacturerId String   @map("manufacturer_id")
  name           String
  nameNormalized String   @map("name_normalized")
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  manufacturer Manufacturer    @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  series       ProductSeries[]
  products     ProductModel[]

  @@unique([manufacturerId, nameNormalized])
  @@map("divisions")
}

model ProductSeries {
  id             String   @id @default(cuid())
  manufacturerId String   @map("manufacturer_id")
  divisionId     String?  @map("division_id")
  name           String
  nameNormalized String   @map("name_normalized")
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  manufacturer Manufacturer   @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  division     Division?      @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  products     ProductModel[]

  @@unique([manufacturerId, nameNormalized])
  @@map("product_series")
}

model CatalogCategory {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String   @map("name_normalized")
  description    String?
  hsnCode        String?  @map("hsn_code")
  defaultGstRate Decimal? @map("default_gst_rate") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subCategories SubCategory[]
  attributeDefs AttributeDef[]
  products      ProductModel[]
  requirements  ActivityRequirement[]

  @@unique([nameNormalized])
  @@map("catalog_categories")
}

model SubCategory {
  id             String   @id @default(cuid())
  categoryId     String   @map("category_id")
  name           String
  nameNormalized String   @map("name_normalized")
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  category CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products ProductModel[]

  @@unique([categoryId, nameNormalized])
  @@map("sub_categories")
}

model AttributeDef {
  id             String        @id @default(cuid())
  categoryId     String        @map("category_id")
  name           String
  nameNormalized String        @map("name_normalized")
  description    String?
  type           AttributeType
  unit           String?
  options        String[]      @default([])
  required       Boolean       @default(false)
  sortOrder      Int           @default(0) @map("sort_order")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  category CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([categoryId, nameNormalized])
  @@map("attribute_defs")
}

model UnitDef {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String   @map("name_normalized")
  description    String?
  symbol         String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  products ProductModel[]

  @@unique([nameNormalized])
  @@map("unit_defs")
}

model TaxRate {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String   @map("name_normalized")
  description    String?
  ratePercent    Decimal  @map("rate_percent") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([nameNormalized])
  @@map("tax_rates")
}

model HsnCode {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String   @map("name_normalized")
  description    String?
  gstRate        Decimal? @map("gst_rate") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([nameNormalized])
  @@map("hsn_codes")
}

// ── Products & variants ──────────────────────────────────────────────────

model ProductModel {
  id               String        @id @default(cuid())
  tenantId         String?       @map("tenant_id")
  name             String
  nameNormalized   String        @map("name_normalized")
  description      String?
  manufacturerId   String?       @map("manufacturer_id")
  manufacturerName String?       @map("manufacturer_name")
  divisionId       String?       @map("division_id")
  seriesId         String?       @map("series_id")
  seriesName       String?       @map("series_name")
  categoryId       String?       @map("category_id")
  categoryName     String?       @map("category_name")
  subCategoryId    String?       @map("sub_category_id")
  subCategoryName  String?       @map("sub_category_name")
  attributes       Json          @default("{}")
  unitId           String?       @map("unit_id")
  unitName         String?       @map("unit_name")
  hsnCode          String?       @map("hsn_code")
  gstRate          Decimal?      @map("gst_rate") @db.Decimal(5, 2)
  images           Json          @default("{\"gallery\":[]}")
  status           ProductStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  manufacturer Manufacturer?    @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  division     Division?        @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  series       ProductSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  category     CatalogCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory  SubCategory?     @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  unit         UnitDef?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  variants     Variant[]

  @@index([manufacturerId, seriesId, nameNormalized])
  @@index([categoryId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("products")
}

model Variant {
  id               String        @id @default(cuid())
  productId        String        @map("product_id")
  name             String
  modelCode        String?       @map("model_code")
  manufacturerSku  String?       @map("manufacturer_sku")
  internalSku      String?       @map("internal_sku")
  barcode          String?
  ean              String?
  attributes       Json          @default("{}")
  priceMrp         Decimal?      @map("price_mrp") @db.Decimal(12, 2)
  priceDealer      Decimal?      @map("price_dealer") @db.Decimal(12, 2)
  priceDistributor Decimal?      @map("price_distributor") @db.Decimal(12, 2)
  priceContractor  Decimal?      @map("price_contractor") @db.Decimal(12, 2)
  pricePurchase    Decimal?      @map("price_purchase") @db.Decimal(12, 2)
  priceOffer       Decimal?      @map("price_offer") @db.Decimal(12, 2)
  gstRate          Decimal?      @map("gst_rate") @db.Decimal(5, 2)
  discountPercent  Decimal?      @map("discount_percent") @db.Decimal(5, 2)
  stockQty         Int?          @map("stock_qty")
  status           ProductStatus @default(ACTIVE)
  image            Json?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  product ProductModel @relation(fields: [productId], references: [id], onDelete: Cascade)
  requirementOptions ActivityRequirementOption[]

  @@index([productId])
  @@index([modelCode])
  @@index([manufacturerSku])
  @@index([internalSku])
  @@index([barcode])
  @@map("variants")
}

// ── Activities ────────────────────────────────────────────────────────────

model Activity {
  id           String          @id @default(cuid())
  tenantId     String?         @map("tenant_id")
  code         String          @unique
  name         String
  wiringType   WiringType      @map("wiring_type")
  category     String?
  segment      ProjectSegment?
  unit         UnitOfMeasure
  description  String?
  isActive     Boolean         @default(true) @map("is_active")
  sheetData    Json?           @map("sheet_data")
  materialCost Decimal?        @map("material_cost") @db.Decimal(12, 2)
  labourCost   Decimal?        @map("labour_cost") @db.Decimal(12, 2)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  requirements ActivityRequirement[]

  @@index([wiringType])
  @@index([segment])
  @@index([tenantId])
  @@map("activities")
}

model ActivityRequirement {
  id          String        @id @default(cuid())
  activityId  String        @map("activity_id")
  categoryId  String        @map("category_id")
  description String
  unit        UnitOfMeasure
  quantity    Decimal       @db.Decimal(12, 2)
  sortOrder   Int           @default(0) @map("sort_order")

  activity Activity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  category CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  options  ActivityRequirementOption[]

  @@index([activityId])
  @@index([categoryId])
  @@map("activity_requirements")
}

// One row per alternate "make" (a specific catalog variant) a requirement can be fulfilled
// with. Exactly one option per requirement is flagged isDefault — that's the make whose name
// and price populate the requirement's row in the Activity's own spreadsheet; Quotations pick
// among these same options via their own per-row override instead of the full catalog search.
model ActivityRequirementOption {
  id            String   @id @default(cuid())
  requirementId String   @map("requirement_id")
  variantId     String   @map("variant_id")
  isDefault     Boolean  @default(false) @map("is_default")
  sortOrder     Int      @default(0) @map("sort_order")

  requirement ActivityRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  variant     Variant             @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([requirementId, variantId])
  @@index([requirementId])
  @@index([variantId])
  @@map("activity_requirement_options")
}

// ── Quotations ────────────────────────────────────────────────────────────

model Quotation {
  id                     String          @id @default(cuid())
  tenantId               String?         @map("tenant_id")
  code                   String          @unique
  status                 QuotationStatus @default(DRAFT)
  subTotal               Decimal         @default(0) @map("sub_total") @db.Decimal(14, 2)
  taxTotal               Decimal         @default(0) @map("tax_total") @db.Decimal(14, 2)
  grandTotal             Decimal         @default(0) @map("grand_total") @db.Decimal(14, 2)
  validTill              DateTime?       @map("valid_till")
  termsAndConditions     String?         @map("terms_and_conditions")
  sheetData              Json?           @map("sheet_data")
  activityRows           Json?           @map("activity_rows")
  activityCustomizations Json?           @map("activity_customizations")
  brandPreferences       Json?           @map("brand_preferences")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  customer QuotationCustomer?
  project  QuotationProject?
  items    QuotationItem[]

  @@index([tenantId])
  @@map("quotations")
}

model QuotationCustomer {
  id          String  @id @default(cuid())
  quotationId String  @unique @map("quotation_id")
  name        String
  phone       String?
  address     String?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_customers")
}

model QuotationProject {
  id          String    @id @default(cuid())
  quotationId String    @unique @map("quotation_id")
  code        String    @unique
  name        String
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_projects")
}

model QuotationItem {
  id          String   @id @default(cuid())
  quotationId String   @map("quotation_id")
  description String
  unit        String
  quantity    Decimal  @db.Decimal(12, 2)
  rate        Decimal  @db.Decimal(12, 2)
  discountPct Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  profitPct   Decimal  @default(0) @map("profit_pct") @db.Decimal(5, 2)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  amount      Decimal  @db.Decimal(14, 2)
  sortOrder   Int      @default(0) @map("sort_order")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// ── Auth & users ──────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  role         UserRole
  status       UserStatus @default(APPROVED)
  companyName  String?    @map("company_name")
  adminId      String?    @map("admin_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
